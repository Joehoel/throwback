{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "dev:vite": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --config playwright.config.ts",
    "generate:openapi": "tsx tools/generate-openapi.ts",
    "generate:client": "openapi-ts",
    "generate:format": "oxfmt --write openapi.json src/client/generated",
    "generate": "bun run generate:openapi && bun run generate:client && bun run generate:format",
    "typecheck": "bun run typecheck:app && bun run typecheck:server && bun run typecheck:generated",
    "typecheck:app": "node node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:server": "node node_modules/typescript-7/bin/tsc -p tsconfig.server.json",
    "typecheck:generated": "node node_modules/typescript-7/bin/tsc -p tsconfig.generated.json",
    "verify:boundaries": "tsx tools/verify-boundaries.ts",
    "verify:clean-rebuild": "tsx tools/verify-clean-rebuild.ts",
    "verify:codegen": "tsx tools/verify-codegen.ts",
    "lint": "oxlint --threads=4 --format=unix",
    "lint:fix": "oxlint --threads=4 --format=unix --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "LEFTHOOK_CONFIG=lefthook.yml lefthook install",
    "prepare": "bun run hooks:install",
    "plan": "alchemy plan --stage preview",
    "deploy": "alchemy deploy --stage preview",
    "destroy": "alchemy destroy --stage preview"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-persist-client": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "@tanstack/router-plugin": "1.168.37",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "effect": "4.0.0-rc.112",
    "embla-carousel-react": "8.6.0",
    "idb-keyval": "6.2.2",
    "input-otp": "1.5.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.12.4",
    "recharts": "3.8.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/parser": "8.0.5",
    "@babel/traverse": "8.0.5",
    "@babel/types": "8.0.5",
    "@cloudflare/workers-types": "5.20260911.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@hey-api/openapi-ts": "0.99.0",
    "@oxlint/plugins": "1.82.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "alchemy": "2.0.0-beta.76",
    "babel-plugin-react-compiler": "1.0.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.8",
    "ws": "8.21.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "lightningcss",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "workerd"
  ]
}
