{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "dev:vite": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:d1": "vitest run --project d1",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --config playwright.config.ts",
    "generate:openapi": "tsx tools/generate-openapi.ts",
    "generate:client": "openapi-ts",
    "generate:format": "oxfmt --write openapi.json src/client/generated",
    "generate": "bun run generate:openapi && bun run generate:client && bun run generate:format",
    "typecheck": "bun run typecheck:app && bun run typecheck:server && bun run typecheck:generated",
    "typecheck:app": "node node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck:server": "node node_modules/typescript-7/bin/tsc -p tsconfig.server.json",
    "typecheck:generated": "node node_modules/typescript-7/bin/tsc -p tsconfig.generated.json",
    "verify:boundaries": "tsx tools/verify-boundaries.ts",
    "verify:codegen": "tsx tools/verify-codegen.ts",
    "lint": "oxlint --threads=4 --format=unix",
    "lint:fix": "oxlint --threads=4 --format=unix --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "LEFTHOOK_CONFIG=lefthook.yml lefthook install",
    "prepare": "bun run hooks:install",
    "plan": "alchemy plan",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
