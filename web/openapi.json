{
  "openapi": "3.1.0",
  "info": {
    "title": "Throwback Beheer-webapp API",
    "version": "1.0.0"
  },
  "paths": {
    "/bootstrap": {
      "get": {
        "tags": ["bootstrap"],
        "operationId": "getBootstrap",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "BootstrapState",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapState"
                }
              }
            }
          },
          "409": {
            "description": "BuildUpgradeRequired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildUpgradeRequiredEncoded"
                }
              }
            }
          },
          "503": {
            "description": "CuratorAccessUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuratorAccessUnavailableEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/curator/claim": {
      "post": {
        "tags": ["curator"],
        "operationId": "claimCurator",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "BootstrapState",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapState"
                }
              }
            }
          },
          "401": {
            "description": "AuthenticationRequired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationRequiredEncoded"
                }
              }
            }
          },
          "403": {
            "description": "CuratorOwnershipConflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuratorOwnershipConflictEncoded"
                }
              }
            }
          },
          "409": {
            "description": "BuildUpgradeRequired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildUpgradeRequiredEncoded"
                }
              }
            }
          },
          "503": {
            "description": "CuratorAccessUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuratorAccessUnavailableEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmCuratorClaim"
              }
            }
          },
          "required": true
        }
      }
    },
    "/library/folders": {
      "get": {
        "tags": ["library"],
        "operationId": "listLibraryFolders",
        "parameters": [
          {
            "name": "parentFolderId",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/DriveItemId"
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "FolderBrowserState",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderBrowserState"
                }
              }
            }
          },
          "401": {
            "description": "GraphReauthenticationRequired | AuthenticationRequired",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/GraphReauthenticationRequiredEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/AuthenticationRequiredEncoded"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "CuratorOwnershipConflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuratorOwnershipConflictEncoded"
                }
              }
            }
          },
          "404": {
            "description": "OneDriveFolderNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OneDriveFolderNotFoundEncoded"
                }
              }
            }
          },
          "409": {
            "description": "LibraryAlreadySelected | BuildUpgradeRequired",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/LibraryAlreadySelectedEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/BuildUpgradeRequiredEncoded"
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "OneDriveUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OneDriveUnavailableEncoded"
                }
              }
            }
          },
          "503": {
            "description": "LibraryStoreUnavailable | CuratorAccessUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/LibraryStoreUnavailableEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/CuratorAccessUnavailableEncoded"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/library/selection": {
      "post": {
        "tags": ["library"],
        "operationId": "selectLibrary",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "LibraryIndexing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryIndexing"
                }
              }
            }
          },
          "400": {
            "description": "InvalidLibrarySelection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidLibrarySelectionEncoded"
                }
              }
            }
          },
          "401": {
            "description": "GraphReauthenticationRequired | AuthenticationRequired",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/GraphReauthenticationRequiredEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/AuthenticationRequiredEncoded"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "CuratorOwnershipConflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuratorOwnershipConflictEncoded"
                }
              }
            }
          },
          "404": {
            "description": "OneDriveFolderNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OneDriveFolderNotFoundEncoded"
                }
              }
            }
          },
          "409": {
            "description": "LibraryAlreadySelected | BuildUpgradeRequired",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/LibraryAlreadySelectedEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/BuildUpgradeRequiredEncoded"
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "OneDriveUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OneDriveUnavailableEncoded"
                }
              }
            }
          },
          "503": {
            "description": "LibraryStoreUnavailable | LibraryIndexUnavailable | CuratorAccessUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/LibraryStoreUnavailableEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/LibraryIndexUnavailableEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/CuratorAccessUnavailableEncoded"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectLibraryRequest"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignInRequired": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["SignInRequired"]
          },
          "reason": {
            "type": "string",
            "enum": ["signedOut", "ownerMismatch"]
          }
        },
        "required": ["_tag", "reason"],
        "additionalProperties": false
      },
      "CuratorClaimRequired": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["CuratorClaimRequired"]
          },
          "account": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": ["microsoft"]
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": ["provider", "name", "email"],
            "additionalProperties": false
          }
        },
        "required": ["_tag", "account"],
        "additionalProperties": false
      },
      "GraphConnectionRequired": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["GraphConnectionRequired"]
          },
          "account": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": ["microsoft"]
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": ["provider", "name", "email"],
            "additionalProperties": false
          }
        },
        "required": ["_tag", "account"],
        "additionalProperties": false
      },
      "LibrarySelectionRequired": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["LibrarySelectionRequired"]
          }
        },
        "required": ["_tag"],
        "additionalProperties": false
      },
      "LibraryId": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "format": "throwback-library-id"
          }
        ]
      },
      "LibraryRootDisplay": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "path"],
        "additionalProperties": false
      },
      "LibraryIndexProgress": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "retrying",
              "waiting_for_reauthentication",
              "failed",
              "active"
            ]
          },
          "pagesProcessed": {
            "type": "integer"
          },
          "processedItems": {
            "type": "integer"
          },
          "reviewBlocked": {
            "type": "boolean"
          }
        },
        "required": ["status", "pagesProcessed", "processedItems", "reviewBlocked"],
        "additionalProperties": false
      },
      "LibraryIndexing": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["LibraryIndexing"]
          },
          "libraryId": {
            "$ref": "#/components/schemas/LibraryId"
          },
          "rootFolder": {
            "$ref": "#/components/schemas/LibraryRootDisplay"
          },
          "progress": {
            "$ref": "#/components/schemas/LibraryIndexProgress"
          }
        },
        "required": ["_tag", "libraryId", "rootFolder", "progress"],
        "additionalProperties": false
      },
      "EventId": {
        "type": "string",
        "format": "throwback-event-id"
      },
      "PhotoId": {
        "type": "string",
        "format": "throwback-photo-id"
      },
      "ReviewReady": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["ReviewReady"]
          },
          "libraryId": {
            "$ref": "#/components/schemas/LibraryId"
          },
          "eventId": {
            "$ref": "#/components/schemas/EventId"
          },
          "photoId": {
            "$ref": "#/components/schemas/PhotoId"
          }
        },
        "required": ["_tag", "libraryId", "eventId", "photoId"],
        "additionalProperties": false
      },
      "BootstrapState": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/SignInRequired"
          },
          {
            "$ref": "#/components/schemas/CuratorClaimRequired"
          },
          {
            "$ref": "#/components/schemas/GraphConnectionRequired"
          },
          {
            "$ref": "#/components/schemas/LibrarySelectionRequired"
          },
          {
            "$ref": "#/components/schemas/LibraryIndexing"
          },
          {
            "$ref": "#/components/schemas/ReviewReady"
          }
        ]
      },
      "CuratorAccessUnavailableEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["CuratorAccessUnavailable"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "BuildUpgradeRequiredEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["BuildUpgradeRequired"]
          },
          "currentBuildId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "currentBuildId", "message"],
        "additionalProperties": false
      },
      "ConfirmCuratorClaim": {
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["confirmed"],
        "additionalProperties": false
      },
      "CuratorOwnershipConflictEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["CuratorOwnershipConflict"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "AuthenticationRequiredEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["AuthenticationRequired"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "DriveItemId": {
        "type": "string",
        "allOf": [
          {
            "minLength": 1,
            "format": "throwback-drive-item-id"
          }
        ]
      },
      "FolderLocation": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DriveItemId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "isDriveRoot": {
            "type": "boolean"
          },
          "parentFolderId": {
            "$ref": "#/components/schemas/DriveItemId"
          }
        },
        "required": ["id", "name", "path", "isDriveRoot"],
        "additionalProperties": false
      },
      "SelectableFolder": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DriveItemId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "childCount": {
            "type": "number"
          }
        },
        "required": ["id", "name", "childCount"],
        "additionalProperties": false
      },
      "FolderBrowserState": {
        "type": "object",
        "properties": {
          "current": {
            "$ref": "#/components/schemas/FolderLocation"
          },
          "folders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SelectableFolder"
            }
          }
        },
        "required": ["current", "folders"],
        "additionalProperties": false
      },
      "GraphReauthenticationRequiredEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["GraphReauthenticationRequired"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "LibraryAlreadySelectedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["LibraryAlreadySelected"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "LibraryStoreUnavailableEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["LibraryStoreUnavailable"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "OneDriveFolderNotFoundEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["OneDriveFolderNotFound"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "OneDriveUnavailableEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["OneDriveUnavailable"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "SelectLibraryRequest": {
        "type": "object",
        "properties": {
          "rootFolderId": {
            "$ref": "#/components/schemas/DriveItemId"
          },
          "confirmed": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["rootFolderId", "confirmed"],
        "additionalProperties": false
      },
      "LibraryIndexUnavailableEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["LibraryIndexUnavailable"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "InvalidLibrarySelectionEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["InvalidLibrarySelection"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [
    {
      "name": "bootstrap"
    },
    {
      "name": "curator"
    },
    {
      "name": "library"
    }
  ]
}
